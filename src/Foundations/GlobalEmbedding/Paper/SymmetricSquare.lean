import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Basic.Real.Basic

/-!
# The symmetric square as a quotient

Source: `literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203,
where the true second form is regarded as a linear map on `Sym² TM`; the explicit quotient model
is specified by DAG node `immersion-symmetric-square`. The paper's notation defines
`u ⊙ v = (u ⊗ v + v ⊗ u) / 2` at lines 1129–1130. The quotient class of `u ⊗ v` is identified
with that normalized tensor only after a separate equivalence with the real symmetric-tensor
subspace is constructed and proved. This module constructs no such equivalence.
-/

namespace GlobalEmbedding.Paper

open scoped TensorProduct

/-- The submodule generated by `v ⊗ w - w ⊗ v`.

Source: `literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203,
which places `Sym² TM` in the domain of the true second form. The quotient presentation is the
explicit realization required by DAG node `immersion-symmetric-square`.
-/
def symmetricSquareRelations (V : Type*) [AddCommGroup V] [Module ℝ V] :
    Submodule ℝ (V ⊗[ℝ] V) :=
  Submodule.span ℝ (Set.range fun p : V × V ↦ p.1 ⊗ₜ[ℝ] p.2 - p.2 ⊗ₜ[ℝ] p.1)

/-- The binary real symmetric square: `V ⊗ V` modulo the span of `v ⊗ w - w ⊗ v`.

Source: `literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203,
where `Sym² TM` is the domain of the true second form. The quotient model is the formal definition
of DAG node `immersion-symmetric-square`.
-/
abbrev SymmetricSquare (V : Type*) [AddCommGroup V] [Module ℝ V] :=
  (V ⊗[ℝ] V) ⧸ symmetricSquareRelations V

/-- The canonical quotient map from `V ⊗ V` to the symmetric square.

Source: this is the quotient map in the model of `Sym² TM` used for the true second form in
`literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203; the
quotient presentation is specified by DAG node `immersion-symmetric-square`.
-/
def symmetricSquareQuotient (V : Type*) [AddCommGroup V] [Module ℝ V] :
    (V ⊗[ℝ] V) →ₗ[ℝ] SymmetricSquare V :=
  Submodule.mkQ (symmetricSquareRelations V)

/-- The canonical bilinear symmetric product, represented by the quotient class of `v ⊗ w`.

Source: the paper regards the true second form as a map on `Sym² TM` in
`literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203. Its
separate notation `u ⊙ v = (u ⊗ v + v ⊗ u) / 2` is at lines 1129–1130. This quotient-valued
product has no factor of `1/2`; its relation to that normalized tensor requires a separately
proved equivalence, which is not asserted here.
-/
def symmetricSquareProduct (V : Type*) [AddCommGroup V] [Module ℝ V] :
    V →ₗ[ℝ] V →ₗ[ℝ] SymmetricSquare V where
  toFun v := (symmetricSquareQuotient V).comp (TensorProduct.mk ℝ V V v)
  map_add' v w := by
    ext z
    simp [TensorProduct.mk_apply]
  map_smul' c v := by
    ext z
    simp [TensorProduct.mk_apply]

/-- Applying the canonical product gives the quotient class of the pure tensor.

Source: `literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203,
where `Sym² TM` is the domain of the true second form. The paper's normalized notation
`u ⊙ v = (u ⊗ v + v ⊗ u) / 2` is defined at lines 1129–1130; identifying this quotient class
with that tensor requires a separately proved equivalence and normalization argument.
-/
@[simp]
theorem symmetricSquareProduct_apply (V : Type*) [AddCommGroup V] [Module ℝ V]
    (v w : V) :
    symmetricSquareProduct V v w = symmetricSquareQuotient V (v ⊗ₜ[ℝ] w) := rfl

/-- The canonical product is symmetric because its antisymmetric difference is killed in the
quotient.

Source: `literature/parallelizable-stable-plus-one/main.tex`, Definition `defn:phase`, line 203;
the symmetry follows from the stated quotient model of `Sym² TM`.
-/
theorem symmetricSquareProduct_comm (V : Type*) [AddCommGroup V] [Module ℝ V]
    (v w : V) : symmetricSquareProduct V v w = symmetricSquareProduct V w v := by
  rw [symmetricSquareProduct_apply, symmetricSquareProduct_apply]
  apply (Submodule.Quotient.eq (p := symmetricSquareRelations V)).2
  change v ⊗ₜ[ℝ] w - w ⊗ₜ[ℝ] v ∈ symmetricSquareRelations V
  exact Submodule.subset_span ⟨(v, w), rfl⟩

end GlobalEmbedding.Paper
